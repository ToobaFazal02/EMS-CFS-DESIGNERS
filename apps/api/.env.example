APP_NAME=CFS Designers
# Local: generate with  python -c "import secrets; print(secrets.token_hex(32))"
# Never commit the real key. API will refuse to start if this is still change-me.
SECRET_KEY=change-me-in-production-use-long-random
EMS_ENV=dev
DATABASE_URL=sqlite+aiosqlite:///./ems_data/ems.db
ACCESS_TOKEN_EXPIRE_MINUTES=720
DATA_DIR=./ems_data
SCREENSHOT_RETENTION_DAYS=60
IDLE_SECONDS=180
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
TIMEZONE=Asia/Karachi
AUTO_SEED_SAMPLES=false
# VPS only:
# EMS_ENV=production
# Include website + Tauri desktop origins (Manager app webview)
# CORS_ORIGINS=https://ems.cfsdesigners.com,https://tauri.localhost,http://tauri.localhost,tauri://localhost
# AUTO_SEED_SAMPLES=false
